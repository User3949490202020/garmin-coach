# Copie ce fichier en ".env" et remplis tes identifiants Garmin Connect.
# Ce fichier reste EN LOCAL sur ta machine, il n'est jamais envoyé nulle part.
GARMIN_EMAIL=ton_email@example.com
GARMIN_PASSWORD=ton_mot_de_passe

# Clé API Gemini, uniquement nécessaire pour l'onglet "Coach IA".
# Gratuite, sans carte bancaire : à créer sur https://aistudio.google.com
GEMINI_API_KEY=
